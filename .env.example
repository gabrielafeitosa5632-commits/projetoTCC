# Em desenvolvimento, deixe vazio para usar o proxy do Vite em http://127.0.0.1:8000.
# No APK, informe a URL HTTPS pública da API, sem barra no final.
VITE_SEGMENTATION_API_URL=

# Destino usado apenas pelo proxy do Vite.
SEGMENTATION_API_PROXY_TARGET=http://127.0.0.1:8000

# Autenticação online (Supabase).
# Use somente a URL do projeto e a chave pública sb_publishable_... .
# Nunca coloque aqui uma chave secret ou service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional para uma URL HTTPS verificada. Sem esta variável, o APK usa:
# com.phytopathometric.app://auth/callback e ...://auth/reset
VITE_AUTH_REDIRECT_URL=
